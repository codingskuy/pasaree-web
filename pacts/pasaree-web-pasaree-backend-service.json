        {
          "name": "akun produsen memiliki satu lapak aktif"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer token-uji"
          ]
        },
        "method": "GET",
        "path": "/web/lapak-saya"
      },
      "response": {
        "body": {
          "content": {
            "data": [
              {
                "id": "01J0000000000000000000001",
                "nama_lapak": "Lapak Contoh Sleman",
                "saldo_tertahan_idr": 0,
                "skor_fulfillment_persen": 95,
                "slug": "lapak-contoh",
                "status": "AKTIF"
